# =============================================================
# Copiloto Comercial Industrial — Variables de entorno
# Copia este archivo como .env.local y completa los valores
# NUNCA subir .env.local a git (ya está en .gitignore)
# =============================================================

# --- Supabase ---
# URL del proyecto (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable (Project Settings > API > publishable key)
# Es segura para el cliente; las reglas de RLS protegen los datos
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave service_role — SOLO para API routes del servidor, JAMÁS al cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- Anthropic (IA) ---
# console.anthropic.com > API Keys
# Solo se usa en API routes del servidor
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- OpenAI Whisper (transcripción de llamadas) ---
# platform.openai.com > API Keys
# Solo se usa en API routes del servidor
OPENAI_API_KEY=sk-proj-...

# --- Autenticación de las rutas /api/** ---
# Bearer token que middleware.ts exige en cada request a /api/**.
# Genera una con:  npx tsx generate-api-key.ts
#
# Si esta variable NO está definida, la validación queda inactiva y las
# rutas /api quedan abiertas. Es a propósito: con la variable ausente, un
# deploy dejaría la app entera en 401.
#
# IMPORTANTE: esto NO protege las llamadas que nacen en el navegador. El
# frontend hace 92 fetch a /api desde el cliente y ninguno manda este
# header; un secreto que le des al navegador queda expuesto en el bundle.
# Para el tráfico de navegador el perímetro es Vercel Deployment Protection
# (ver DEPLOYMENT_PROTECTION_SETUP.md).
API_SECRET_KEY=

# --- Opcional: configuración ---
# URL pública de la app (para callbacks de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
